    {
      "parameters": {
        "jsCode": "function parseRelativeTime(text, referenceTime) {\n  if (!text) return null;\n\n  const isoCheck = DateTime.fromISO(text);\n  if (isoCheck.isValid) return isoCheck;\n\n  const match = text.match(/(\\d+)\\s*(minute|hour|day|week|month)s?\\s*ago/i);\n  if (!match) return null;\n\n  const value = parseInt(match[1], 10);\n  const unit = match[2].toLowerCase();\n\n  const unitMap = {\n    minute: 'minutes',\n    hour: 'hours',\n    day: 'days',\n    week: 'weeks',\n    month: 'months'\n  };\n\n  return referenceTime.minus({ [unitMap[unit]]: value });\n}\n\nconst referenceTime = $now;\n\nreturn items.map(item => {\n  const parsedDate = parseRelativeTime(item.json.date_posted, referenceTime);\n  return {\n    json: {\n      ...item.json,\n      date_posted: parsedDate ? parsedDate.toISO() : null,           // for filtering\n      date_posted_display: parsedDate ? parsedDate.toFormat('MMMM d, yyyy') : ''  // for display\n    }\n  };\n});"
      },
